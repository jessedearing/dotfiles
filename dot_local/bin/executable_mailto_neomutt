#!/usr/bin/env python3
"""Open a neomutt compose in a new tmux pane from a mailto: URI."""

import os
import shlex
import subprocess
import sys
import tempfile
from urllib.parse import parse_qs, unquote

NEOMUTT_CONFIG = os.path.expanduser("~/.config/neomutt/neomuttrc")


def clean_header(value):
    return value.replace("\r", " ").replace("\n", " ")


def main():
    if len(sys.argv) < 2:
        print("usage: mailto_neomutt.sh 'mailto:...'", file=sys.stderr)
        return 1

    uri = sys.argv[1]
    if uri.startswith("mailto:"):
        uri = uri[len("mailto:"):]

    address_part, _, query = uri.partition("?")

    recipients = []
    for addr in address_part.split(","):
        addr = unquote(addr).strip()
        if addr:
            recipients.append(addr)

    params = parse_qs(query, keep_blank_values=True)

    def first(key):
        values = params.get(key)
        return values[0] if values else ""

    for to in params.get("to", []):
        if to:
            recipients.append(to)

    cc = first("cc")
    bcc = first("bcc")
    subject = first("subject")
    body = first("body")

    lines = []
    if recipients:
        lines.append("To: %s" % clean_header(", ".join(recipients)))
    if cc:
        lines.append("Cc: %s" % clean_header(cc))
    if bcc:
        lines.append("Bcc: %s" % clean_header(bcc))
    if subject:
        lines.append("Subject: %s" % clean_header(subject))
    lines.append("")
    lines.append(body)

    fd, draft = tempfile.mkstemp(suffix=".eml")
    with open(fd, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")

    command = "neomutt -F %s -H %s; rm -f %s" % (
        shlex.quote(NEOMUTT_CONFIG),
        shlex.quote(draft),
        shlex.quote(draft),
    )
    subprocess.run(["tmux", "split-window", "-p", "40", command], check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
