theme = TokyoNight
{{- if eq .chezmoi.os "darwin" }}
font-family = Monolisa
font-thicken = false
font-size = 14
keybind = cmd+,=text:\x01,
keybind = cmd+.=text:\x01.
keybind = ctrl+enter=toggle_fullscreen
{{- else }}
font-family = Monolisa Variable
font-thicken = true
font-size = 12
{{- end }}
window-width = 195
window-height = 60
background-opacity = 0.9
keybind = ctrl+left_bracket=text:\x1b

mouse-hide-while-typing = true
